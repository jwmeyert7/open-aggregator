# Copy to .env.local for local dev. Everything is optional locally: with no
# variables at all, npm run dev serves the site from .data/ with the LLM off.

# --- LLM (one of the two, the gateway wins when both are set) ---

# Vercel AI Gateway key (pass-through pricing, no separate Anthropic account).
AI_GATEWAY_API_KEY=
# Direct Anthropic API key (looks like sk-ant-...).
ANTHROPIC_API_KEY=
# Override the editor model (default anthropic/claude-haiku-4-5).
LLM_MODEL=

# --- Hosting and pipeline ---

# Vercel Blob state store token. Auto-populated when you attach a Blob store
# to the Vercel project. Leave unset locally: state falls back to .data/.
BLOB_READ_WRITE_TOKEN=
# Protects /api/cron. REQUIRED in production: the cron route fails closed and
# the pipeline never runs without it. Vercel Cron sends it automatically.
CRON_SECRET=
# Canonical site URL for permalinks and bot posts (overrides config).
SITE_URL=

# --- Admin ---

# The single shared password for /admin.
ADMIN_PASSWORD=
# Signs admin session cookies. Recommended: a long random string, so a leaked
# cookie says nothing about the password. Falls back to ADMIN_PASSWORD.
SESSION_SECRET=

# --- Email digests (optional, Gmail app password is the worked example) ---

# SMTP server (default smtp.gmail.com) and port (default 465).
SMTP_HOST=
SMTP_PORT=
# SMTP login. For Gmail: your address and an app password from myaccount.google.com/apppasswords.
SMTP_USER=
SMTP_PASS=
# Outbound From: address (defaults to the configured contactEmail).
MAIL_FROM=

# --- Social posting (optional, bots dry-run until credentials exist) ---

# X API (pay-per-use). All four are required to post for real.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Farcaster via Neynar (free tier) plus a signer for your bot account.
NEYNAR_API_KEY=
FARCASTER_SIGNER_UUID=
# Set to 1 to force bots into dry-run even with credentials present.
DRY_RUN=

# --- Media shelf (optional) ---

# YouTube Data API key, for episode lengths and view counts on the podcasts
# shelf (one quota unit per video, ten thousand a day free). Without it the
# pipeline scrapes each watch page as a best effort, which datacenter egress
# often cannot do, so lengths and view counts may simply stay unknown.
YOUTUBE_API_KEY=

# --- Analytics (optional) ---

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Consent-gated on the site.
NEXT_PUBLIC_GA_ID=
